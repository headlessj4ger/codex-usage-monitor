<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../src/assets/app.ico</ApplicationIcon>
    <Version>3.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Content Include="../src/*.xaml;../src/*.cjs;../src/version.json;../src/assets/*;../src/runtime/*" Exclude="../src/runtime/*.download" Link="%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="../src/assets/*" Link="assets/%(Filename)%(Extension)" />
    <Content Update="../src/runtime/*" Link="runtime/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
