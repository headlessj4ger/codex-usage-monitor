<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Codex 会话动态" Width="400" Height="326" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
 Background="Transparent" FontFamily="{DynamicResource ChineseFont}" FontSize="12" Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="theme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style x:Key="MiniFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Stroke="{StaticResource Accent}" StrokeThickness="1" RadiusX="5" RadiusY="5" Margin="1"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MiniButton" TargetType="{x:Type ButtonBase}">
   <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6,5"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource MiniFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ButtonBase}"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#24FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MiniPin" TargetType="ToggleButton" BasedOn="{StaticResource MiniButton}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{StaticResource PopupSurface}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/><Setter Property="Padding" Value="10,7"/><Setter Property="MaxWidth" Value="400"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter><ContentPresenter.Resources><DataTemplate DataType="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ContentPresenter.Resources></ContentPresenter></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="MinWidth" Value="0"/><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{StaticResource ScrollThumb}" CornerRadius="2" Margin="2,4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="{StaticResource PopupSurface}"/><Setter Property="FontFamily" Value="{StaticResource UIFont}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="MinWidth" Value="128"/><Setter Property="Padding" Value="5"/><Setter Property="HasDropShadow" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuChrome" Background="Transparent" CornerRadius="4" Padding="10,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Check" Text="✓" Visibility="Hidden" Foreground="{StaticResource Accent}"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuChrome" Property="Background" Value="#22FFFFFF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   </ResourceDictionary>
 </Window.Resources>
 <Border x:Name="MiniSurface" BorderThickness="0" Padding="1" CornerRadius="0" Background="{StaticResource GlassTint}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <Grid x:Name="MiniCaption" Background="Transparent" Margin="20,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Path Data="M 0,10 L 5,10 8,2 12,17 15,8 18,10 22,10" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="18" Margin="0,0,12,0"/>
     <TextBlock Text="会话动态" FontSize="17.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Border Background="{StaticResource Badge}" CornerRadius="6" Margin="14,0,0,0" Width="24" Height="22"><TextBlock x:Name="MiniCount" Text="0" FontSize="15" FontFamily="{StaticResource UIFont}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/></Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <ToggleButton x:Name="MiniTopmost" Style="{StaticResource MiniPin}" IsChecked="True" Width="36" ToolTip="置顶" AutomationProperties.Name="置顶小窗"><Path Data="M 3,1 L 11,1 10,7 13,10 1,10 4,7 Z M 7,10 L 7,16" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" StrokeLineJoin="Round" Width="14" Height="17"/></ToggleButton>
     <Button x:Name="MiniExpand" Style="{StaticResource MiniButton}" Width="36" ToolTip="返回主窗口" AutomationProperties.Name="返回主窗口"><Path Data="M 5,1 L 1,1 1,5 M 10,1 L 14,1 14,5 M 1,10 L 1,14 5,14 M 10,14 L 14,14 14,10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="15" Height="15"/></Button>
     <Button x:Name="MiniClose" Style="{StaticResource MiniButton}" Width="36" ToolTip="收起小窗 · Esc" AutomationProperties.Name="收起小窗"><Path Data="M 2,2 L 12,12 M 2,12 L 12,2" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14"/></Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="16,0" ToolTip="每行仅计会话自身的输出，包含推理 token。速率按响应入账计算。"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="会话" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/><TextBlock x:Name="MiniTrendHeader" Grid.Column="1" Text="近 5 分钟" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="输出 tok/s" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/><Border Grid.ColumnSpan="3" Height="1" Background="#16FFFFFF" VerticalAlignment="Bottom"/></Grid>
   <Grid Grid.Row="2">
    <ListBox x:Name="MiniList" Margin="8,0" BorderThickness="0" Padding="0" Background="Transparent" Foreground="{StaticResource TextPrimary}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" SelectionMode="Single" AutomationProperties.Name="会话动态速率列表">
     <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" Padding="0" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="52"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="{Binding Tooltip}"/><Setter Property="AutomationProperties.Name" Value="{Binding Accessible}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{Binding RowFill}" ClipToBounds="True" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0DFFFFFF"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsKeyboardFocusWithin" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="#18FFFFFF"/></MultiTrigger>
<DataTrigger Binding="{Binding Phase}" Value="enter"><DataTrigger.EnterActions><BeginStoryboard><Storyboard FillBehavior="Stop">
<DoubleAnimation Storyboard.TargetProperty="Height" From="0" To="52" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
<DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
</Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
<DataTrigger Binding="{Binding Phase}" Value="exit"><Setter Property="IsHitTestVisible" Value="False"/><DataTrigger.EnterActions><BeginStoryboard x:Name="ExitMotion"><Storyboard FillBehavior="HoldEnd">
<DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
</Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ExitMotion"/></DataTrigger.ExitActions></DataTrigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
      <Grid Margin="{Binding Indent}"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Branch}" FontSize="18" Foreground="{Binding SubtitleTone}" Margin="-20,0,0,0" VerticalAlignment="Center"/><Ellipse x:Name="StateDot" Fill="{Binding Tone}" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0"><TextBlock Text="{Binding Title}" Foreground="{Binding TitleTone}" FontSize="15.5" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{Binding SubtitleTone}" FontFamily="{StaticResource UIFont}" FontSize="11.5" Height="16" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{Binding ChartOpacity}" AutomationProperties.Name="{Binding ChartLabel}">
         <Border Width="7" Height="{Binding H0}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T0}"/>
         <Border Width="7" Height="{Binding H1}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T1}"/>
         <Border Width="7" Height="{Binding H2}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T2}"/>
         <Border Width="7" Height="{Binding H3}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T3}"/>
         <Border Width="7" Height="{Binding H4}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T4}"/>
         <Border Width="7" Height="{Binding H5}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T5}"/>
         <Border Width="7" Height="{Binding H6}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T6}"/>
         <Border Width="7" Height="{Binding H7}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T7}"/>
         <Border Width="7" Height="{Binding H8}" VerticalAlignment="Bottom" Background="{Binding ChartTone}" CornerRadius="1,1,0,0" Margin="0,0,4,0" ToolTip="{Binding T8}"/>
         <Border Width="7" Height="{Binding H9}" VerticalAlignment="Bottom" Background="{Binding ChartLastTone}" CornerRadius="1,1,0,0" Margin="0" ToolTip="{Binding T9}"/>
      </StackPanel>
      <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
<TextBlock Text="{Binding Rate}" Visibility="{Binding RateVisibility}" FontFamily="{StaticResource UIFont}" Typography.NumeralAlignment="Tabular" FontSize="20" Foreground="{Binding RateTone}"/>
<Grid x:Name="StateMark" Width="24" Height="24" Visibility="{Binding MarkVisibility}">
<Ellipse Stroke="{Binding Tone}" StrokeThickness="1.2" Width="18" Height="18" Visibility="{Binding RingVisibility}"/>
<TextBlock Text="{Binding Mark}" FontFamily="Segoe UI" FontSize="16" Foreground="{Binding Tone}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
</Grid></Grid>
      <Border Grid.ColumnSpan="3" Height="1" Background="#10FFFFFF" VerticalAlignment="Bottom" Visibility="{Binding SeparatorVisibility}"/>
     </Grid><DataTemplate.Triggers>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Motion}" Value="yes"/><Condition Binding="{Binding State}" Value="waiting"/></MultiDataTrigger.Conditions><MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.42" AutoReverse="True" RepeatBehavior="2x" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Motion}" Value="yes"/><Condition Binding="{Binding State}" Value="failed"/></MultiDataTrigger.Conditions><MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="StateMark" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="2x" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Motion}" Value="yes"/><Condition Binding="{Binding State}" Value="completed"/></MultiDataTrigger.Conditions><MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="StateMark" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Motion}" Value="yes"/><Condition Binding="{Binding State}" Value="interrupted"/></MultiDataTrigger.Conditions><MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="StateMark" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions></MultiDataTrigger>
</DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel x:Name="MiniEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,12"><TextBlock x:Name="MiniEmptyTitle" Text="暂无会话动态" Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Center"/><TextBlock x:Name="MiniEmptyHint" Text="新任务开始后会自动出现" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#16FFFFFF" BorderThickness="0,1,0,0"><Grid Margin="16,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTipService.ShowDuration="20000"><StackPanel.ToolTip><TextBlock x:Name="MiniFreshness" Text="等待采集" TextWrapping="Wrap"/></StackPanel.ToolTip><Ellipse x:Name="MiniStatusDot" Fill="{StaticResource Accent}" Width="6" Height="6" Margin="0,0,8,0"/><TextBlock x:Name="MiniStatus" Text="近 1 分钟均值" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" x:Name="MiniRefresh" Style="{StaticResource MiniButton}" AutomationProperties.Name="小窗刷新间隔" ToolTip="设置小窗刷新间隔 · F5 立即刷新"><StackPanel Orientation="Horizontal"><TextBlock x:Name="MiniRefreshLabel" Text="5 秒刷新" FontFamily="{StaticResource UIFont}" FontSize="12"/><Path Data="M 0,0 L 4,4 8,0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.1" Width="8" Height="4" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button></Grid></Border>
  </Grid>
 </Border>
</Window>
