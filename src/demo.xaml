<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="动效演示 · 模拟数据" Width="400" Height="205" ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="True" Topmost="True"
 Background="#292E3B" Foreground="#F0F1F4" FontFamily="Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True">
 <Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DemoStep" Text="新会话" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="DemoIndex" Grid.Column="1" Text="1 / 15" Foreground="#A1ABBD" VerticalAlignment="Center"/></Grid>
  <TextBlock x:Name="DemoHint" Grid.Row="1" Text="会话行展开淡入" Foreground="#B5BDCD" Margin="0,7,0,0" TextWrapping="Wrap" Height="36"/>
  <Grid Grid.Row="2" Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><ComboBox x:Name="DemoScene" Height="26" VerticalAlignment="Center" ToolTip="选择要看的状态" AutomationProperties.Name="演示阶段"/><ComboBox x:Name="DemoSpeed" Grid.Column="1" Margin="8,0,0,0" Height="26" VerticalAlignment="Center" ToolTip="阶段停留速度；原生动画时长保持一致" AutomationProperties.Name="演示播放速度"/></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="DemoPause" Content="暂停" Height="30" Margin="0,0,6,0" AutomationProperties.Name="暂停或继续演示"/>
   <Button x:Name="DemoNext" Grid.Column="1" Content="下一步" Height="30" Margin="3,0,3,0"/>
   <Button x:Name="DemoReplay" Grid.Column="2" Content="重播" Height="30" Margin="6,0,0,0"/>
  </Grid>
 </Grid>
</Window>
