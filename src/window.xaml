       <DataGridTemplateColumn Header="会话" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="{Binding Indent}" ToolTip="{Binding Tooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="{Binding Chevron}" Tag="{Binding Id}" Padding="0" MinHeight="26" Width="17" FontSize="10" AutomationProperties.Name="展开或折叠子会话"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="周期 token" Width="115" Binding="{Binding Week}" ElementStyle="{StaticResource Number}"/><DataGridTextColumn Header="校准占比" Width="85" Binding="{Binding Estimate}"/>
      </DataGrid.Columns></DataGrid>
      <DataGrid x:Name="ModelGrid" Visibility="Collapsed" AutomationProperties.Name="模型与思考深度组合"><DataGrid.Columns><DataGridTemplateColumn Header="模型 / 思考深度" Width="*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="周期 token" Width="120" Binding="{Binding Week}" ElementStyle="{StaticResource Number}"/><DataGridTextColumn Header="校准占比" Width="85" Binding="{Binding Estimate}"/><DataGridTextColumn Header="有效区间" Width="70" Binding="{Binding Samples}" ElementStyle="{StaticResource Number}"/></DataGrid.Columns></DataGrid>
      <DataGrid x:Name="ProcessGrid" Visibility="Collapsed" AutomationProperties.Name="Windows 进程关联树"><DataGrid.Columns><DataGridTemplateColumn Header="进程 / 父子关系" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="{Binding Indent}" ToolTip="{Binding Tooltip}"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PID" Width="75" Binding="{Binding Pid}" ElementStyle="{StaticResource Number}"/><DataGridTextColumn Header="内存 MB" Width="85" Binding="{Binding Memory}" ElementStyle="{StaticResource Number}"/></DataGrid.Columns></DataGrid>
      <ScrollViewer x:Name="HelpView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="统计口径" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,18"/><TextBlock x:Name="MethodText" TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource TextSecondary}"/></StackPanel></ScrollViewer>
      <StackPanel x:Name="EmptyView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"><TextBlock Text="暂无符合条件的记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="新响应入账后会自动更新。也可以调整筛选条件，或点击刷新。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0"/></StackPanel>
     </Grid><TextBlock x:Name="StatusText" Grid.Row="3" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <Border x:Name="DetailPane" Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Background="{StaticResource PanelSurface}"><Grid Margin="20,19,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><Grid><TextBlock x:Name="DetailEyebrow" Text="会话详情" Foreground="{StaticResource TextMuted}" FontSize="10.5"/><Button x:Name="CloseDetails" Content="×" HorizontalAlignment="Right" Padding="7,0" MinHeight="20" ToolTip="关闭详情"/></Grid><TextBlock x:Name="DetailTitle" Text="选择一个会话" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,0" MaxHeight="66" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DetailSubtitle" Text="查看用量、速度与关联信息" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,11"/><Button x:Name="OpenSession" Content="打开完整会话详情  →" FontSize="11.5" HorizontalAlignment="Left" Padding="0,5" Foreground="{StaticResource Accent}"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,12,0,0"><ScrollViewer x:Name="LiveDetails" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Grid x:Name="SpeedMetrics" Margin="0,6,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="近 1 分钟输出" FontSize="11" Foreground="{StaticResource TextMuted}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="RateOne" Text="—" FontFamily="{StaticResource UIFont}" Typography.NumeralAlignment="Tabular" FontSize="25"/><TextBlock Text="tok/s" Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="5,0,0,3" VerticalAlignment="Bottom"/></StackPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="近 5 分钟输出" FontSize="11" Foreground="{StaticResource TextMuted}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="RateFive" Text="—" FontFamily="{StaticResource UIFont}" Typography.NumeralAlignment="Tabular" FontSize="25"/><TextBlock Text="tok/s" Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="5,0,0,3" VerticalAlignment="Bottom"/></StackPanel></StackPanel></Grid>
      <StackPanel x:Name="TrendSection" Margin="0,0,0,22"><Grid><TextBlock Text="输出趋势" FontSize="11.5"/><TextBlock Text="近 5 分钟 · 30 秒 / 柱" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right"/></Grid><Grid Margin="0,10,0,0"><Canvas x:Name="TrendCanvas" Height="134" ClipToBounds="True"/><TextBlock x:Name="TrendEmpty" Text="等待响应入账" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Grid Margin="0,6,0,0"><TextBlock x:Name="TrendStart" FontSize="9.5" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TrendEnd" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="SpeedCaveat" Text="响应入账速率，包含推理输出。" Foreground="{StaticResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0" ToolTip="日志在响应结束后记账；这是窗口平均值，不是逐 token 生成速度。无新记录时为 0 不代表模型停止。"/></StackPanel>
      <ItemsControl x:Name="DetailFacts" ItemTemplate="{StaticResource FactsTemplate}"/>
     </StackPanel></ScrollViewer>
     <TabControl x:Name="SessionDetailTabs" Visibility="Collapsed" FontSize="11.5">
      <TabItem Header="用量"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SessionFacts" ItemTemplate="{StaticResource FactsTemplate}"/></ScrollViewer></TabItem>
      <TabItem Header="执行"><DataGrid x:Name="CommandsGrid" RowHeight="48" FontSize="11.5"><DataGrid.Columns><DataGridTemplateColumn Header="命令" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Tooltip}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="状态" Width="70" Binding="{Binding State}"/><DataGridTextColumn Header="秒" Width="55" Binding="{Binding Duration}"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="模型"><DataGrid x:Name="SessionModelsGrid" RowHeight="48" FontSize="11.5"><DataGrid.Columns><DataGridTemplateColumn Header="模型组合" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Tooltip}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="token" Width="100" Binding="{Binding Total}"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="每日"><DataGrid x:Name="DailyGrid" RowHeight="33" FontSize="11.5"><DataGrid.Columns><DataGridTextColumn Header="日期" Width="*" Binding="{Binding Day}"/><DataGridTextColumn Header="token" Width="130" Binding="{Binding Total}" ElementStyle="{StaticResource Number}"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="关联"><DataGrid x:Name="RelationsGrid" RowHeight="52" FontSize="11.5" ToolTip="双击查看关联会话"><DataGrid.Columns><DataGridTemplateColumn Header="关联会话 · 双击查看" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Tooltip}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></TabItem>
     </TabControl></Grid>
    </Grid></Border>
   </Grid>
  </Grid>
 </Border>
</Window>
